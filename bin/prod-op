#!/usr/bin/env python3
"""prod-op: production steps that a session runs only after the owner's Go in the approval app (Polar).

  prod-op request script --name DIR --why "..."      # $PROD_OP_SCRIPT_ROOT/DIR/run.sh, modes: dry | apply
  prod-op run ID                                     # only after Go in Polar; runs once
  prod-op show ID | list

`request` pins everything (a copy of the script folder and its file hashes) and sends one Polar decision card
whose title ends with the hash of the pinned request. `run` checks that the owner chose Go on that card, that
the hash still matches, and that the op did not run before. Each run is logged in
~/.local/state/prod-op/ledger.jsonl. Add your own kinds (a feature flag, a dashboard publish) by adding a
build_<kind> and apply_<kind> function and registering them in BUILD and APPLY.

Environment: POLAR_BIN (approval app CLI, default `polar`), PROD_OP_SCRIPT_ROOT (default ~/.local/share/agent-tasks).
"""
import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import uuid
from datetime import datetime, timezone
from pathlib import Path

HOME = Path.home()
STATE = HOME / '.local/state/prod-op'
OPS = STATE / 'ops'
LEDGER = STATE / 'ledger.jsonl'
POLAR = Path(os.environ.get('POLAR_BIN') or 'polar')
SCRIPT_ROOT = Path(os.environ.get('PROD_OP_SCRIPT_ROOT') or HOME / '.local/share/agent-tasks')
SCRIPT_MAX_BYTES = 2_000_000
TAIL = 40
GO_HOURS = 12            # a Go older than this does not run
# add your own token patterns here; matches are hidden from every printed or stored output
SECRET_RE = re.compile(r'(gh[pousr]_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9_-]{20,}|xox[abprs]-[A-Za-z0-9-]+)')

OUTSIDE_RE = re.compile(r'agent-tasks/|(^|[;&|\s])(source|\.)\s+[~/$]', re.M)
NAME_RE = re.compile(r'^[a-z0-9][a-z0-9_.-]{0,99}$')


class Refuse(Exception):
    pass


def now():
    return datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')


def canon(obj):
    return json.dumps(obj, sort_keys=True, separators=(',', ':'), ensure_ascii=False)


def own_requester():
    """«<claude session id> <tmux session>» of the Claude session that runs prod-op, or "". The card then names that
    session, so Polar types the owner's Go into it (a card with only «prod-op <id>» reaches nobody)."""
    sid, pid = "", os.getppid()
    for _ in range(10):
        f = os.path.expanduser(f"~/.claude/sessions/{pid}.json")
        if os.path.exists(f):
            try:
                sid = json.load(open(f)).get("sessionId") or ""
            except (OSError, ValueError):
                pass
            break
        out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True).stdout.strip()
        if not out or out == "1":
            break
        pid = int(out)
    tm = ""
    if sid and os.environ.get("TMUX"):
        tmux = shutil.which("tmux") or "tmux"
        tm = subprocess.run([tmux, "display-message", "-p", "#S"], capture_output=True, text=True).stdout.strip()
    return f"{sid} {tm}".strip()


def spec_hash(spec):
    return hashlib.sha256(canon(spec).encode()).hexdigest()


def redact(text):
    return SECRET_RE.sub('[secret]', text or '')


def tail(text, n=TAIL):
    lines = redact(text).rstrip('\n').splitlines()
    return '\n'.join(lines[-n:])


def run_cmd(argv, cwd=None, env=None):
    p = subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True)
    return p.returncode, redact((p.stdout or '') + (p.stderr or ''))


def snapshot_files(root):
    files, total = {}, 0
    for p in sorted(root.rglob('*')):
        rel = p.relative_to(root).as_posix()
        if p.is_symlink():
            raise Refuse(f'script folder has a symlink: {rel}')
        if p.is_file():
            data = p.read_bytes()
            total += len(data)
            if total > SCRIPT_MAX_BYTES:
                raise Refuse('script folder is larger than 2 MB')
            files[rel] = hashlib.sha256(data).hexdigest()
    return files


def build_script(a, op_dir):
    if not NAME_RE.match(a.name or '') or '..' in a.name:
        raise Refuse('--name: one folder name under ~/.local/share/agent-tasks')
    src = SCRIPT_ROOT / a.name
    if not (src / 'run.sh').is_file():
        raise Refuse(f'{src}/run.sh not found (it must accept "dry" and "apply")')
    snap = op_dir / 'snapshot'
    shutil.copytree(src, snap, symlinks=True)
    files = snapshot_files(snap)
    for rel in files:
        text = (snap / rel).read_text(errors='replace')
        if OUTSIDE_RE.search(text):
            raise Refuse(f'{rel} reads another task folder or sources a file outside the folder; '
                         'put every file the script needs in its own folder')
    spec = {'kind': 'script', 'name': a.name, 'files': files}
    names = ', '.join(sorted(files))
    detail = f'Script {a.name}, files: {names}. Read it first: prod-op show ID'
    note = ('prod-op does not run the script before the Go. Run `bash run.sh dry` yourself first and put '
            'its result in --why.\nFiles: ' + names + '\n')
    return spec, f'script {a.name}', note, detail


def apply_script(spec, op_dir, polar_id):
    snap = op_dir / 'snapshot'
    if snapshot_files(snap) != spec['files']:
        raise Refuse('the script copy changed after the request; make a new request')
    return run_cmd(['bash', 'run.sh', 'apply'], cwd=snap,
                   env=dict(os.environ, PROD_OP_MODE='apply', PROD_OP_POLAR_ID=polar_id))


BUILD = {'script': build_script}
APPLY = {'script': apply_script}


# ---------- state + Polar ----------

def load(op_id):
    if not re.match(r'^[0-9a-f]{12}$', op_id or ''):
        raise Refuse('op id: 12 hex characters')
    d = OPS / op_id
    if not (d / 'op.json').exists():
        raise Refuse(f'no op {op_id}')
    return d, json.loads((d / 'op.json').read_text())


def save(d, op):
    tmp = d / 'op.json.tmp'
    tmp.write_text(json.dumps(op, indent=2, ensure_ascii=False))
    tmp.replace(d / 'op.json')


def ledger(entry):
    STATE.mkdir(parents=True, exist_ok=True)
    with open(LEDGER, 'a') as f:
        f.write(canon(entry) + '\n')


def polar(args):
    rc, out = run_cmd([str(POLAR)] + args)
    if rc != 0:
        raise Refuse(f'polar failed (exit {rc}): {tail(out, 5)}')
    i, j = out.find('{'), out.rfind('}')
    return json.loads(out[i:j + 1])


def cmd_request(a):
    why = ' '.join((a.why or '').split())
    if not why:
        raise Refuse('--why: one plain line for the owner')
    op_id = uuid.uuid4().hex[:12]
    d = OPS / op_id
    d.mkdir(parents=True, exist_ok=False)
    os.chmod(d, 0o700)
    try:
        spec, summary, dry, detail = BUILD[a.kind](a, d)
        h = spec_hash(spec)
        (d / 'dry.out').write_text(redact(dry))
        title = f'Production: {summary} · {h[:10]}'
        detail = detail.replace('prod-op show ID', f'prod-op show {op_id}')
        line2 = 'Exact change: ' + detail
        room = 280 - len(line2) - 1
        if room < 40:
            line2, room = line2[:200] + '…', 79
        context = (why if len(why) <= room else why[:room - 1] + '…') + '\n' + line2
        card = polar(['ask', 'decision', '--title', title, '--context', context, '--force-context',
                      '--expires-hours', str(GO_HOURS),
                      '--requester', f'prod-op {op_id} {a.requester or own_requester()}'.strip(),
                      '--requester-label', a.requester_label or f'prod-op {a.kind}',
                      '--option', 'go:Run in production', '--option', 'no:Do not run'])
    except BaseException:
        shutil.rmtree(d, ignore_errors=True)
        raise
    op = {'id': op_id, 'state': 'pending', 'created_at': now(), 'summary': summary, 'title': title,
          'context': context, 'hash': h, 'polar_id': card['id'], 'spec': spec}
    save(d, op)
    ledger({'at': now(), 'event': 'request', 'id': op_id, 'polar_id': card['id'], 'hash': h, 'summary': summary})
    print(f'op {op_id}: Polar card {card["id"]} sent: «{title}»\n{context}')
    print(f'dry run (full: {d}/dry.out):\n{tail(dry, 20)}')
    print(f'After Go: prod-op run {op_id}')
    return 0


def cmd_run(a):
    d, op = load(a.id)
    if op['state'] != 'pending':
        raise Refuse(f'op {op["id"]} is {op["state"]}; it runs once. Make a new request.')
    age = datetime.now(timezone.utc) - datetime.strptime(op['created_at'], '%Y-%m-%dT%H:%M:%SZ').replace(tzinfo=timezone.utc)
    if age.total_seconds() > GO_HOURS * 3600:
        raise Refuse(f'the request is older than {GO_HOURS} h; make a new request')
    if spec_hash(op['spec']) != op['hash']:
        raise Refuse('the stored request changed after the Polar card; make a new request')
    st = polar(['status', op['polar_id']])
    if not str(st.get('title', '')).endswith(op['hash'][:10]):
        raise Refuse('the Polar card title does not carry this request hash')
    if st.get('status') != 'chosen' or st.get('chosen_option') != 'go':
        raise Refuse(f'no Go yet: Polar {op["polar_id"]} is {st.get("status")} '
                     f'{st.get("chosen_option") or ""}'.rstrip())
    try:
        fd = os.open(d / 'run.lock', os.O_CREAT | os.O_EXCL | os.O_WRONLY)
        os.close(fd)
    except FileExistsError:
        raise Refuse('this op is running or ran already')
    op['state'] = 'running'
    op['started_at'] = now()
    save(d, op)
    ledger({'at': now(), 'event': 'start', 'id': op['id'], 'polar_id': op['polar_id'], 'hash': op['hash']})
    try:
        rc, out = APPLY[op['spec']['kind']](op['spec'], d, op['polar_id'])
    except Refuse as e:
        rc, out = 1, f'refused during run: {e}\n'
    except Exception as e:  # keep the ledger honest on a crash
        rc, out = 1, f'error during run: {e!r}\n'
    except BaseException:
        op['state'] = 'interrupted'
        op['finished_at'] = now()
        save(d, op)
        ledger({'at': now(), 'event': 'interrupted', 'id': op['id'], 'polar_id': op['polar_id']})
        raise
    (d / 'run.out').write_text(redact(out))
    op['state'] = 'done' if rc == 0 else 'failed'
    op['finished_at'] = now()
    op['exit'] = rc
    save(d, op)
    ledger({'at': now(), 'event': op['state'], 'id': op['id'], 'polar_id': op['polar_id'], 'exit': rc})
    print(f'op {op["id"]} {op["state"]} (exit {rc}); full output {d}/run.out\n{tail(out)}')
    return 0 if rc == 0 else 1


def cmd_show(a):
    d, op = load(a.id)
    print(json.dumps(op, indent=2, ensure_ascii=False))
    for f in ('dry.out', 'run.out'):
        if (d / f).exists():
            print(f'--- {f}\n{tail((d / f).read_text())}')
    return 0


def cmd_list(a):
    if not OPS.exists():
        return 0
    rows = []
    for d in OPS.iterdir():
        try:
            op = json.loads((d / 'op.json').read_text())
            rows.append((op['created_at'], op['id'], op['state'], op['polar_id'], op['summary']))
        except Exception:
            continue
    for r in sorted(rows):
        print('  '.join(r))
    return 0


def main(argv=None):
    p = argparse.ArgumentParser(prog='prod-op', description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest='cmd', required=True)
    r = sub.add_parser('request')
    rk = r.add_subparsers(dest='kind', required=True)
    for kind in ('script',):
        k = rk.add_parser(kind)
        k.add_argument('--why', required=True)
        k.add_argument('--requester')
        k.add_argument('--requester-label')
        k.add_argument('--name', required=True)
    for name in ('run', 'show'):
        s = sub.add_parser(name)
        s.add_argument('id')
    sub.add_parser('list')
    a = p.parse_args(argv)
    try:
        return {'request': cmd_request, 'run': cmd_run, 'show': cmd_show, 'list': cmd_list}[a.cmd](a)
    except Refuse as e:
        print(f'prod-op: {e}', file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
